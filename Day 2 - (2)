#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    if (n < 10)
        printf("Insufficient Earning\n");
    else if (n < 100)
        printf("Very Low Earning\n");
    else if (n < 1000)
        printf("Low Earning\n");
    else if (n < 10000)
        printf("Sufficient Earning\n");
    else
        printf("High Earning\n");

    return 0;
}

