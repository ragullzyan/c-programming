#include <stdio.h>

void main() {
    int a, b, c;

    printf("Enter 3 integer numbers : ");
    scanf("%d %d %d", &a, &b, &c);

    (a > b) && (a > c) ? printf("%d is the largest number\n", a) :
    (b > c) ? printf("%d is the largest number\n", b) :
    printf("%d is the largest number\n", c);
}
